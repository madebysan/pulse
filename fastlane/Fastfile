require "json"
require "shellwords"

default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "Pulse.xcodeproj")
SCHEME = "Pulse"
APP_IDENTIFIER = "com.madebysan.pulse"
APP_STORE_APPLE_ID = "6771900515"
PROFILE_NAME = "#{APP_IDENTIFIER} AppStore"
PROFILE_DIR = File.join(ROOT, "build/profiles")
PROFILE_FILENAME = "Pulse_AppStore.mobileprovision"
RELEASE_VERSION = "1.0"
RELEASE_BUILD = "1"
ASC_TEAM_ID = "121817262"
DEV_PORTAL_TEAM_ID = "QAMM2A6WRQ"
COPYRIGHT_TEXT = "2026 Santiago Alonso"
REVIEW_NOTES = "No account is required. Pulse estimates beats per minute from user taps only. It does not use HealthKit, camera, microphone, network requests, analytics, or third-party SDKs. The onboarding and App Store metadata state that Pulse is not a medical device and should not be used for diagnosis or treatment decisions."
# Your App Store Connect login, from the environment (for example fastlane/.env, which Git ignores).
def apple_id
  ENV.fetch("APPLE_ID") { UI.user_error!("Set APPLE_ID to your App Store Connect login") }
end

API_KEY_JSON_PATH = ENV.fetch(
  "APP_STORE_CONNECT_API_KEY_PATH",
  File.expand_path("~/private_keys/api_key.json")
)

def asc_api_key
  UI.user_error!("App Store Connect API key JSON not found at #{API_KEY_JSON_PATH}") unless File.exist?(API_KEY_JSON_PATH)

  api_key = JSON.parse(File.read(API_KEY_JSON_PATH), symbolize_names: true)
  key_filepath = File.expand_path(api_key.fetch(:key_filepath), File.dirname(API_KEY_JSON_PATH))
  app_store_connect_api_key(
    key_id: api_key.fetch(:key_id),
    issuer_id: api_key.fetch(:issuer_id),
    key_filepath: key_filepath,
    duration: api_key.fetch(:duration, 1200),
    in_house: api_key.fetch(:in_house, false)
  )
end

def assert_command!(command)
  UI.user_error!("Command failed: #{command}") unless system(command)
end

def find_free_us_price_point!(app_id)
  params = Spaceship::ConnectAPI.tunes_request_client.build_params(
    filter: {
      territory: "USA"
    },
    fields: {
      appPricePoints: "customerPrice,proceeds,territory"
    },
    limit: 200
  )
  response = Spaceship::ConnectAPI.tunes_request_client.get("v1/apps/#{app_id}/appPricePoints", params)
  price_points = response.all_pages.flat_map { |page| page.body.fetch("data", []) }
  free_price = price_points.find do |price_point|
    attributes = price_point.fetch("attributes", {})
    attributes["customerPrice"].to_s == "0.0" || attributes["customerPrice"].to_s == "0"
  end

  UI.user_error!("Could not find a free USA app price point for #{APP_IDENTIFIER}.") if free_price.nil?

  free_price.fetch("id")
end

def set_free_app_store_pricing!(app)
  price_point_id = find_free_us_price_point!(app.id)
  manual_price_id = "${free-price-usa}"
  body = {
    data: {
      type: "appPriceSchedules",
      relationships: {
        app: {
          data: {
            type: "apps",
            id: app.id
          }
        },
        baseTerritory: {
          data: {
            type: "territories",
            id: "USA"
          }
        },
        manualPrices: {
          data: [
            {
              type: "appPrices",
              id: manual_price_id
            }
          ]
        }
      }
    },
    included: [
      {
        type: "appPrices",
        id: manual_price_id,
        attributes: {
          startDate: nil
        },
        relationships: {
          appPricePoint: {
            data: {
              type: "appPricePoints",
              id: price_point_id
            }
          }
        }
      }
    ]
  }

  Spaceship::ConnectAPI.tunes_request_client.post("v1/appPriceSchedules", body)
end

platform :ios do
  before_all do
    ENV["FASTLANE_HIDE_CHANGELOG"] = "1"
    ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
  end

  desc "Local preflight: build settings, privacy manifest, icon alpha, screenshot dimensions"
  lane :preflight do
    issues = []

    pbxproj = File.join(ROOT, "Pulse.xcodeproj/project.pbxproj")
    privacy_manifest = File.join(ROOT, "Pulse/PrivacyInfo.xcprivacy")
    issues << "Missing PrivacyInfo.xcprivacy" unless File.exist?(privacy_manifest)
    issues << "Bundle ID is not #{APP_IDENTIFIER}" unless File.read(pbxproj).include?("PRODUCT_BUNDLE_IDENTIFIER = #{APP_IDENTIFIER};")
    issues << "Version/build mismatch" unless File.read(pbxproj).include?("MARKETING_VERSION = #{RELEASE_VERSION};") && File.read(pbxproj).include?("CURRENT_PROJECT_VERSION = #{RELEASE_BUILD};")

    Dir.glob(File.join(ROOT, "Pulse/Assets.xcassets/AppIcon.appiconset/*.png")).each do |icon|
      out = `/usr/bin/sips -g hasAlpha #{Shellwords.escape(icon)} 2>/dev/null`
      issues << "App icon has alpha: #{icon.sub(ROOT + "/", "")}" if out.include?("hasAlpha: yes")
    end

    Dir.glob(File.join(ROOT, "fastlane/screenshots/en-US/*.png")).sort.each do |screenshot|
      out = `/usr/bin/sips -g pixelWidth -g pixelHeight #{Shellwords.escape(screenshot)} 2>/dev/null`
      issues << "Screenshot must be 1320x2868: #{screenshot.sub(ROOT + "/", "")}" unless out.include?("pixelWidth: 1320") && out.include?("pixelHeight: 2868")
    end

    if issues.empty?
      UI.success("Pulse preflight passed.")
    else
      UI.user_error!("Pulse preflight failed:\n  - #{issues.join("\n  - ")}")
    end
  end

  desc "Create or verify the App Store Connect app record"
  lane :create_app_store_record do
    produce(
      app_identifier: APP_IDENTIFIER,
      app_name: "Pulse: Tap Heart Rate",
      username: apple_id,
      sku: "pulse-ios",
      team_id: DEV_PORTAL_TEAM_ID,
      itc_team_id: ASC_TEAM_ID,
      platform: "ios",
      app_version: RELEASE_VERSION
    )
  end

  desc "Read-only App Store Connect status check"
  lane :app_store_status do
    asc_api_key

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    if app
      UI.success("App Store Connect record found for #{APP_IDENTIFIER}.")
    else
      UI.important("No App Store Connect record found for #{APP_IDENTIFIER}.")
    end
  end

  desc "Read-only App Store release status check"
  lane :release_status do
    asc_api_key

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect record found for #{APP_IDENTIFIER}") unless app

    version = app.get_edit_app_store_version(platform: "IOS")
    if version
      UI.message("App Store version: #{version.version_string} (#{version.app_version_state || version.app_store_state})")
    else
      UI.important("No editable App Store version found.")
    end

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: RELEASE_VERSION,
      build_number: RELEASE_BUILD,
      platform: "IOS"
    )
    build = builds.first

    if build
      UI.success("Build found: #{RELEASE_VERSION} (#{build.version}) processing=#{build.processing_state} internal_testing=#{build.ready_for_internal_testing?}")
    else
      UI.important("No build found for #{RELEASE_VERSION} (#{RELEASE_BUILD}).")
    end
  end

  desc "Set App Store pricing to free with USA as the base territory"
  lane :set_free_pricing do
    asc_api_key

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}.") if app.nil?

    set_free_app_store_pricing!(app)
    UI.success("Set #{APP_IDENTIFIER} App Store pricing to free.")
  end

  desc "Build a simulator sanity check"
  lane :build_simulator do
    assert_command!("cd #{ROOT.shellescape} && xcodebuild -project Pulse.xcodeproj -scheme Pulse -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath build/DerivedData build")
  end

  desc "Create or download the App Store provisioning profile"
  lane :provision_app_store do
    sigh(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: DEV_PORTAL_TEAM_ID,
      provisioning_name: PROFILE_NAME,
      output_path: PROFILE_DIR,
      filename: PROFILE_FILENAME,
      platform: "ios"
    )
  end

  desc "Archive an App Store candidate"
  lane :build_app_store do
    provision_app_store

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(ROOT, "build/app-store"),
      output_name: "Pulse.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
      skip_profile_detection: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: DEV_PORTAL_TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => PROFILE_NAME
        }
      }
    )
  end

  desc "Upload an already-built App Store candidate to TestFlight"
  lane :upload_testflight do
    pilot(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: File.join(ROOT, "build/app-store/Pulse.ipa"),
      skip_waiting_for_build_processing: false
    )
  end

  desc "Upload App Store metadata without binary or screenshots"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      username: apple_id,
      team_id: ASC_TEAM_ID,
      dev_portal_team_id: DEV_PORTAL_TEAM_ID,
      app_version: RELEASE_VERSION,
      metadata_path: File.join(ROOT, "fastlane/metadata"),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      app_rating_config_path: File.join(ROOT, "fastlane/age_rating_config.json"),
      primary_category: "HEALTH_AND_FITNESS",
      copyright: COPYRIGHT_TEXT,
      force: true
    )
  end

  desc "Upload App Store screenshots without binary or metadata"
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      username: apple_id,
      team_id: ASC_TEAM_ID,
      dev_portal_team_id: DEV_PORTAL_TEAM_ID,
      app_version: RELEASE_VERSION,
      screenshots_path: File.join(ROOT, "fastlane/screenshots"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Upload App Privacy answers from fastlane/app_privacy_details.json"
  lane :upload_app_privacy do
    upload_app_privacy_details_to_app_store(
      username: apple_id,
      team_id: ASC_TEAM_ID,
      app_identifier: APP_IDENTIFIER,
      json_path: File.join(ROOT, "fastlane/app_privacy_details.json")
    )
  end

  desc "Submit the current App Store candidate for review"
  lane :submit_app_store_review do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      username: apple_id,
      team_id: ASC_TEAM_ID,
      dev_portal_team_id: DEV_PORTAL_TEAM_ID,
      app_version: RELEASE_VERSION,
      build_number: RELEASE_BUILD,
      metadata_path: File.join(ROOT, "fastlane/metadata"),
      screenshots_path: File.join(ROOT, "fastlane/screenshots"),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      app_rating_config_path: File.join(ROOT, "fastlane/age_rating_config.json"),
      primary_category: "HEALTH_AND_FITNESS",
      copyright: COPYRIGHT_TEXT,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true,
      app_review_information: {
        first_name: "Santiago",
        last_name: "Alonso",
        phone_number: ENV.fetch("APP_REVIEW_PHONE"),
        email_address: ENV.fetch("APP_REVIEW_EMAIL") { apple_id },
        notes: REVIEW_NOTES
      },
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
